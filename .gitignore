# Ambiente virtual (bibliotecas instaladas) — cada computador cria o seu
.venv/

# Banco de dados: contém o estoque real, não vai para o repositório
estoque.db
estoque.db-wal
estoque.db-shm

# Arquivos gerados pelo Python
__pycache__/
*.pyc

# Chave que assina o login (gerada na primeira execução) — é secreta
.chave_secreta

# Cópias de segurança do banco (contêm o estoque real)
backups/
